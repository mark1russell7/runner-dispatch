{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/runner-dispatch",
  "version": "0.1.0",
  "description": "One-job CI runners for trusted jobs: the records of a run, a job and a machine, the trust rules as data, the check on the machine, and the life of a machine as a state machine.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/algebra": "^0.8.4",
    "@mark1russell7/quantity": "^0.3.5"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  }
}
